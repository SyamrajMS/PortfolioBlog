---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Fetch 3 latest blog posts sorted by date
const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} activePage="/">

  <!-- Hero Section -->
  <section class="hero">
    <div>
      <!-- badges -->
      <div class="hero-badge">
        CS Engineering
      </div>
      <div class="hero-badge">
        Full-stack
      </div>
      <div class="hero-badge">
        SAAS
      </div>
      <div class="hero-badge">
        AI
      </div>

      <!-- title -->
      <h1 class="hero-title">Syamraj | Full-Stack Developer &amp; SaaS Founder</h1>
      <p class="hero-subtitle">
        I engineer high-performance custom full-stack solutions, specializing in scalable web application architecture
        with React, Python, and a couple of other JS Frameworks. As a founder, I build cloud platforms that bridge the
        digital divide for local
        businesses through zero-cost digital infrastructure, Local LLMs and SLMs Solutions for enterprices etc.
      </p>
      <div class="hero-cta">
        <a href="/projects" class="btn btn-primary">Explore my Projects →</a>
        <a href="/blog" class="btn btn-secondary">Read my Research Blogs</a>
      </div>
    </div>
    <video src="/syamrajHero.mp4" autoplay loop muted></video>
  </section>

  <!-- Core Startup Showcase Feature -->
  <section class="section container">
    <div class="featured-card">
      <span class="featured-tag">Flagship Startup Initiative</span>
      <h2 class="featured-title">
        GoOnline Marketplace
        <span class="domain-badge">goonline.syamraj.in</span>
      </h2>
      <p class="featured-desc">
        A multi-tenant e-commerce marketplace empowering local vendors with free digital storefronts to bridge the
        digital divide. Engineered with decoupled microservices, Enabling small local vendors to go online, show their products without paying any cost for the free version.
      </p>
      <div class="tech-pills">
        <span class="pill">React 18</span>
        <span class="pill">Laravel 11 REST API</span>
        <span class="pill">MySQL</span>
      </div>
      <div>
        <a href="https://goonline.syamraj.in" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Visit Live Platform (goonline.syamraj.in) ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Skill Matrix Section -->
  <section class="section container">
    <h2 class="section-title">Technical Skill Matrix</h2>
    <p class="section-subtitle">Core engineering proficiencies and architectural capabilities.</p>

    <div class="skills-grid">
      <div class="skill-card">
        <div class="skill-icon">⚡</div>
        <h3 class="skill-title">Modern Web Development</h3>
        <p class="skill-desc">I started with Django in the field of web development, later had my experience in python
          frameworks like fast api and flask, Had projects on React, Express JS Applications, PERN Stack Applications,
          etc...(Mostly, I was a Vibe Coder)
        </p>
      </div>

      <div class="skill-card">
        <div class="skill-icon">🚀</div>
        <h3 class="skill-title">Local LLMs and SLMs</h3>
        <p class="skill-desc">Currently working on providing Local LLMs and SLMs setup for companies fostering Privacy
          first and Secure AI. Learning in the field of Deeplearning and SLMs Actively</p>
      </div>

      <div class="skill-card">
        <div class="skill-icon">🗄️</div>
        <h3 class="skill-title">Engineering Fundamentals</h3>
        <p class="skill-desc">I have a fair base on the core Computer Science princples and technology including
          System Architecture, Low level Fundamentals, Computer Networks, Operating system, etc. I am currently a full
          time Computer Science Undergraduate Engineering Student</p>
      </div>

      <div class="skill-card">
        <div class="skill-icon">🔌</div>
        <h3 class="skill-title">REST APIs &amp; Integrations</h3>
        <p class="skill-desc">Secure JWT/OAuth2 authentication workflows, third-party payment gateway hookups, rate
          limiting, AI integrations, etc.</p>
      </div>
    </div>
  </section>

  <!-- Latest Technical Articles & Research Section -->
  <section class="section container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h2 class="section-title" style="margin-bottom: 0.25rem;">Latest Technical Articles &amp; Research</h2>
        <p class="section-subtitle" style="margin-bottom: 0;">Deep-dives into full-stack architecture, performance optimization, and AI systems.</p>
      </div>
      <a href="/blog" class="btn btn-secondary">Explore All Articles →</a>
    </div>

    <div class="blog-grid">
      {latestPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <div style="margin-top: 2.5rem; text-align: center;">
      <a href="/blog" class="btn btn-primary">View All Blog Posts →</a>
    </div>
  </section>

</BaseLayout>