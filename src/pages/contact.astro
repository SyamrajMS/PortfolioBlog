---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<BaseLayout title={`Contact & Collaboration | ${SITE_TITLE}`}
  description="Get in touch with Syamraj for full-stack engineering contracts, SaaS platform consulting, or technical research inquiries."
  activePage="/contact">
  <section class="section container" style="max-width: 800px;">
    <h1 class="section-title">Get in Touch</h1>
    <p class="section-subtitle">
      Have a technical inquiry, contract proposal, or interest in the GoOnline SaaS platform? Send a message below or
      connect via professional developer channels.
    </p>

    <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem;">

      <!-- Contact Form -->
      <div class="featured-card">
        <form action="#" method="POST" id="contact-form">
          <div class="form-group">
            <label for="name" class="form-label">Your Name</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Jane Doe" required />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="jane@example.com" required />
          </div>

          <div class="form-group">
            <label for="subject" class="form-label">Subject</label>
            <input type="text" id="subject" name="subject" class="form-control"
              placeholder="Architecture Consulting / GoOnline Inquiry" required />
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" class="form-control"
              placeholder="Describe your project, architectural needs, or collaboration idea..." required></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">
            Send Message →
          </button>
        </form>
      </div>

      <!-- Social & Direct Channels -->
      <div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;">
        <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          GitHub Profile ↗
        </a>
        <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          LinkedIn Profile ↗
        </a>
      </div>

    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameInput = document.getElementById('name') as HTMLInputElement | null;
        const emailInput = document.getElementById('email') as HTMLInputElement | null;
        const subjectInput = document.getElementById('subject') as HTMLInputElement | null;
        const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

        const name = nameInput?.value || '';
        const email = emailInput?.value || '';
        const subject = subjectInput?.value || 'Contact Form Submission';
        const message = messageInput?.value || '';

        const bodyText = `Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`;
        const mailtoUrl = `mailto:fluraknowhow@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;

        window.location.href = mailtoUrl;
        form.reset();
      });
    }
  </script>
</BaseLayout>