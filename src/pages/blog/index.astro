---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import TagPill from '../../components/TagPill.astro';
import { SITE_TITLE } from '../../consts';

// Fetch all posts and sort by date descending
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect unique tags across all blog posts
const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags || []))
).sort();
---

<BaseLayout
  title={`Technical Articles & Research | ${SITE_TITLE}`}
  description="Deep-dives into full-stack web architecture, database optimization, multi-tenant SaaS engineering, and AI systems by Syamraj."
  activePage="/blog"
>
  <section class="section container" style="max-width: 960px;">
    <!-- Page Header -->
    <header style="margin-bottom: 2.5rem;">
      <span class="hero-badge">TECHNICAL ARTICLES &amp; RESEARCH</span>
      <h1 class="hero-title" style="margin-top: 0.5rem;">Insights, Research &amp; Ideas</h1>
      <p class="hero-subtitle" style="margin-bottom: 0;">
        Deep-dives into full-stack web architecture, database optimization, multi-tenant SaaS engineering, and AI systems by Syamraj.
      </p>
    </header>

    <!-- Search & Filter Bar -->
    <div class="blog-filter-section">
      <!-- Search Input -->
      <div class="search-box-container">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="blog-search-input"
          class="form-control blog-search-input"
          placeholder="Search articles by title, topic, or keyword..."
          aria-label="Search articles"
        />
        <button type="button" id="clear-search-btn" class="clear-search-btn" title="Clear search" style="display: none;">✕</button>
      </div>

      <!-- Topic Tag Filters -->
      <div class="tag-filter-bar">
        <button type="button" class="tag-filter-btn active" data-tag="all">
          All Posts ({posts.length})
        </button>
        {allTags.map((tag) => (
          <button type="button" class="tag-filter-btn" data-tag={tag}>
            {tag}
          </button>
        ))}
      </div>

      <!-- Results Stats Bar -->
      <div class="blog-stats-bar">
        <span id="results-count">Showing {posts.length} articles</span>
      </div>
    </div>

    <!-- Blog Post Grid -->
    <div class="blog-grid" id="blog-grid">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-results-state" class="featured-card" style="display: none; text-align: center; margin-top: 2rem;">
      <span class="featured-tag">NO MATCHES</span>
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">
        No articles found
      </h3>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
        Try adjusting your search query or topic filter.
      </p>
      <button type="button" id="reset-filters-btn" class="btn btn-secondary" style="font-size: 0.85rem;">
        Reset Filters
      </button>
    </div>
  </section>

  <!-- Client-side Interactive Search & Tag Filtering -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-search-btn');
      const tagBtns = document.querySelectorAll('.tag-filter-btn');
      const blogCards = document.querySelectorAll('.blog-card');
      const resultsCount = document.getElementById('results-count');
      const noResults = document.getElementById('no-results-state');
      const resetBtn = document.getElementById('reset-filters-btn');

      let activeTag = 'all';
      let searchQuery = '';

      function filterPosts() {
        let visibleCount = 0;

        blogCards.forEach((card) => {
          const element = card as HTMLElement;
          const tags = (element.getAttribute('data-tags') || '').split(',');
          const title = element.getAttribute('data-title') || '';
          const desc = element.getAttribute('data-description') || '';

          const matchesTag = activeTag === 'all' || tags.includes(activeTag);
          const matchesSearch =
            !searchQuery ||
            title.includes(searchQuery) ||
            desc.includes(searchQuery) ||
            tags.some((t) => t.toLowerCase().includes(searchQuery));

          if (matchesTag && matchesSearch) {
            element.style.display = 'block';
            visibleCount++;
          } else {
            element.style.display = 'none';
          }
        });

        // Update stats bar text
        if (resultsCount) {
          resultsCount.textContent = `Showing ${visibleCount} article${visibleCount === 1 ? '' : 's'}`;
        }

        // Show/hide empty state
        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        // Show/hide clear search button
        if (clearBtn) {
          clearBtn.style.display = searchQuery ? 'inline-flex' : 'none';
        }
      }

      // Handle Tag Click
      tagBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tagBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          activeTag = btn.getAttribute('data-tag') || 'all';
          filterPosts();
        });
      });

      // Handle Search Input
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
          filterPosts();
        });
      }

      // Handle Clear Search
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          searchQuery = '';
          filterPosts();
        });
      }

      // Handle Reset Filters
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          searchQuery = '';
          activeTag = 'all';
          tagBtns.forEach((b) => b.classList.remove('active'));
          const allBtn = document.querySelector('.tag-filter-btn[data-tag="all"]');
          if (allBtn) allBtn.classList.add('active');
          filterPosts();
        });
      }
    });
  </script>
</BaseLayout>
