---
interface Headings {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Headings[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <details class="toc-container" id="toc-details" open>
    <summary class="toc-title">
      <span>Table of Contents</span>
      <span class="toc-chevron">▾</span>
    </summary>
    <ul class="toc-list">
      {filteredHeadings.map((heading) => (
        <li class={`toc-item depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </details>
)}

<script>
  // Ensure TOC is always open on desktop (>860px) and collapsed on mobile (<860px)
  function handleTocState() {
    const toc = document.getElementById('toc-details') as HTMLDetailsElement | null;
    if (!toc) return;
    if (window.innerWidth < 860) {
      toc.removeAttribute('open');
    } else {
      toc.setAttribute('open', '');
    }
  }

  document.addEventListener('DOMContentLoaded', handleTocState);
  window.addEventListener('resize', handleTocState);
</script>
